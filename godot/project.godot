; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="刘晓艳行动"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/LiuXiaoyanAction-GitHub"
run/main_scene="res://scenes/boot.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/branding/demulan-emblem-v17.png"
config/windows_native_icon="res://assets/branding/demulan-v17.ico"

[audio]

general/default_playback_type.web=0
driver/output_latency.web=70

general/text_to_speech=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale=1.5

[threading]

worker_pool/max_threads=4

[rendering]

textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.082, 0.098, 0.102, 1)
