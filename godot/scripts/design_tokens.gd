static func style(fill: Color, edge: Color, width: int = 1) -> StyleBoxFlat:
	var s = StyleBoxFlat.new()
	s.bg_color = fill
	s.border_color = edge
	s.set_border_width_all(width)
	s.content_margin_left = GAP
	s.content_margin_right = GAP
	return s
